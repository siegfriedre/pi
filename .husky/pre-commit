#!/bin/sh

# Get list of staged files before running check
STAGED_FILES=$(git diff --cached --name-only)

node scripts/check-lockfile-commit.mjs
if [ $? -ne 0 ]; then
  exit 1
fi

# Run the check script (formatting, linting, and type checking)
echo "Running formatting, linting, and type checking..."
npm run check
if [ $? -ne 0 ]; then
  echo "❌ Checks failed. Please fix the errors before committing."
  exit 1
fi

RUN_DAAS_TESTS=0
for file in $STAGED_FILES; do
  case "$file" in
    packages/*|.config/*|test/*|package.json|package-lock.json)
      RUN_DAAS_TESTS=1
      break
      ;;
  esac
done

if [ $RUN_DAAS_TESTS -eq 1 ]; then
  echo "Running Daas regression tests..."
  npm run test:daas
  if [ $? -ne 0 ]; then
    echo "Daas regression tests failed."
    exit 1
  fi
fi

# Restage files that were previously staged and may have been modified by formatting
for file in $STAGED_FILES; do
  if [ -f "$file" ]; then
    git add "$file"
  fi
done

echo "✅ All pre-commit checks passed!"
