# Example only; inject variables through your shell, container or company secret store.
# This file is not loaded automatically. Private models/settings JSON is mounted separately.
DAAS_HOST=127.0.0.1
DAAS_PORT=3210
DAAS_PUBLIC_ORIGIN=https://daas.company.example
DAAS_GATEWAY_SECRET=replace-with-a-random-secret-of-at-least-32-characters
DEEPSEEK_API_KEY=replace-with-model-key
DAAS_PLATFORM_BASE_URL=https://data.company.example
# Default: <application root>/.daas/models.json; relative overrides are also relative to application root.
# DAAS_MODELS_FILE=/run/secrets/daas-models.json
# DAAS_DATA_DIR=/var/lib/daas
# DAAS_DEMO=1 is an explicit local demo, never an automatic fallback.
# Legacy DAAS_MODEL_BASE_URL/DAAS_MODEL_KEY/DAAS_MODEL_ID/DAAS_MODEL_HEADERS_JSON remain
# available only when the default models.json is absent and DAAS_MODELS_FILE is not set.
