# Example only. The application does not automatically load this file.
# Docker can load it with --env-file; local development can export these variables.
DAAS_HOST=127.0.0.1
DAAS_PORT=3210
DAAS_PUBLIC_ORIGIN=https://daas.company.example
DAAS_GATEWAY_SECRET=replace-with-a-random-secret-of-at-least-32-characters
DAAS_MODEL_BASE_URL=https://model.company.example/v1
DAAS_MODEL_ID=deepseek-flash
DAAS_MODEL_KEY=replace-with-model-key
DAAS_MODEL_HEADERS_JSON={}
DAAS_PLATFORM_BASE_URL=https://data.company.example
# DAAS_DATA_DIR=/var/lib/daas
# DAAS_DEMO=1 is for isolated local demonstrations only, never automatic in production.
