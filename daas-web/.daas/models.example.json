{
  "providers": {
    "deepseek": {
      "baseUrl": "https://model.company.example/v1",
      "api": "openai-completions",
      "apiKey": "${DEEPSEEK_API_KEY}",
      "authHeader": true,
      "headers": {},
      "compat": {
        "thinkingFormat": "deepseek",
        "maxTokensField": "max_tokens",
        "supportsStore": false,
        "supportsDeveloperRole": false
      },
      "models": [
        {
          "id": "deepseek-flash",
          "name": "DaaS 业务模型",
