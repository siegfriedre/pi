{
  "name": "daas-agent-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DaaS 专用网页 Agent；核心源码快照与应用安装依赖分离",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "tsx --tsconfig daas-web/tsconfig.json daas-web/server/main.ts",
    "demo": "node --experimental-strip-types daas-web/server/main.ts --demo",
    "test": "node --experimental-strip-types --test daas-web/test/*.test.ts",
    "check": "node scripts/check-project.mjs && tsc --noEmit -p daas-web/tsconfig.json",
    "check:project": "node scripts/check-project.mjs",
    "check:upstream": "tsx --tsconfig daas-web/tsconfig.json daas-web/test/upstream-contract.ts",
    "build": "node daas-web/build.mjs",
    "build:offline": "node daas-web/build.mjs",
    "check:release": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "openai": "6.40.0",
    "partial-json": "0.1.7",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "esbuild": "0.28.1",
    "tsx": "4.22.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "protobufjs": "7.6.6",
    "chalk": "5.6.2",
    "ignore": "7.0.5",
    "marked": "18.0.5",
    "undici": "8.5.0",
    "esbuild": "0.28.1",
    "typebox": "1.3.27"
  }
}
